# Local settings. Copy to .env (gitignored) and run every command with: uv run --env-file .env ...
# On Laravel Cloud these come from the environment; the app never reads .env itself.

# Queue backend. Cloud injects REDIS_URL when a Valkey cache is attached.
LARAVEL_CLOUD_QUEUES_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0

# Optional. Cloud injects DATABASE_URL (mysql:// or postgresql://) when a database is attached.
# DATABASE_URL=mysql://root@127.0.0.1:3306/python_cloud_queues

# Cloud sets PORT and WEB_CONCURRENCY; match its 2 vCPU ASGI default locally.
PORT=8000
WEB_CONCURRENCY=2

LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

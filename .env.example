LARAVEL_CLOUD_QUEUES_BACKEND=redis
LARAVEL_CLOUD_QUEUES_REDIS_URL=redis://127.0.0.1:6379/0

# Local Herd MySQL. Cloud injects DATABASE_URL; remote hosts always use TLS.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=python_cloud_queues
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=0
# DATABASE_URL=mysql://root@127.0.0.1:3306/python_cloud_queues

SERVER=stdlib
# WEB_CONCURRENCY=3

# App logs use laravel-cloud-logging (Monolog JSON) at this level.
LOG_LEVEL=INFO
# Logtest probes only. LOG_FORMAT default: json when LARAVEL_CLOUD is set, text locally. Optional: logfmt.
# LOG_FORMAT=json
LOG_STREAM=stdout
# Cloud sets this; keep enabled locally when checking print/crash flushing.
PYTHONUNBUFFERED=1
